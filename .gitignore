# Godot import caches, editor state and generated native reload files.
.godot/
.import/
.nomedia
~*.dll

# Local export credentials and temporary files.
export_credentials.cfg
export.cfg
*.tmp

# Generated exports in the project root.
/build/
/builds/
/exports/
/releases/

# Generated QA belongs outside this repository. These explicit escape hatches
# prevent accidental local output from becoming game resources or commits.
/qa-temp/
/captures/
/temp/
/tests/local-output/
/tests/user-data/
*.log
*.part

# Operating-system metadata.
.DS_Store
Thumbs.db
desktop.ini

# Local Python art-export caches.
__pycache__/
*.pyc

# Keep actual source assets, *.import settings, *.uid sidecars and export_presets.cfg.
